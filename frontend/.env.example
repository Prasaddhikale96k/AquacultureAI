VITE_API_BASE_URL=http://127.0.0.1:8000

# Live-camera LLM analysis cadence: one frame is sent for vision analysis every
# this many milliseconds (default 10000 = ~6 calls/min, sustainable on free LLM
# tiers; 1/sec would exhaust free quotas within a minute). Minimum enforced: 3000.
VITE_LIVE_ANALYZE_MS=10000

# ThingSpeak (read-only). Copy to .env.local and fill in. Never put a Write API key here.
# VITE_* values are visible in the browser bundle, so the Read key is not secret.
VITE_THINGSPEAK_CHANNEL_ID=
VITE_THINGSPEAK_READ_API_KEY=
# Field numbers (1-8). Optional: if blank, a field is matched by the channel's own field label
# (e.g. "Temperature", "Turbidity") and shown as "matched by label, please verify". An explicit number always wins.
# pH and dissolved oxygen: leave blank unless those sensors really upload to the channel.
VITE_THINGSPEAK_FIELD_TEMPERATURE=
VITE_THINGSPEAK_FIELD_TURBIDITY=
VITE_THINGSPEAK_FIELD_PH=
VITE_THINGSPEAK_FIELD_DO=
# Optional: number of recent feeds (default 60) and minutes before a reading counts as stale (default 5)
VITE_THINGSPEAK_RESULTS=
VITE_THINGSPEAK_STALE_MINUTES=
