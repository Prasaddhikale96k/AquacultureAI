# AquacultureAI backend LLM config (Groq primary, Gemini fallback).
# Copy to your shell environment or a local `.env` file that is NEVER committed.
# Keys stay on the backend only -- never put them in frontend/.env.local (Vite
# exposes VITE_* values in the browser bundle).
#
# PowerShell example:
#   $env:GROQ_API_KEY = "gsk_..."
#   $env:GEMINI_API_KEY = "AIza..."
#   python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000

# Required (at least one). Groq is tried first, Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides. Defaults are the best-accuracy models (Oct 2026):
#   Groq text:   openai/gpt-oss-120b -> llama-3.3-70b-versatile -> meta-llama/llama-4-scout-17b-16e-instruct
#   Gemini text: gemini-3.1-pro-preview -> gemini-3.8-flash -> gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.1-pro-preview

# Vision (fish detection) models. Groq vision is tried first, Gemini vision is
# the fallback. Defaults: Groq llama-4-scout (multimodal), Gemini 2.5 Flash
# (set GEMINI_VISION_MODEL=gemini-3.1-pro-preview for max accuracy at higher latency).
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_VISION_MODEL=gemini-2.5-flash

# Detection backend: api (default when a key above is set) or yolo (local
# weights; explicit opt-out that restores the old pipeline).
AQUA_VISION_BACKEND=api

# Sampled analysis bounds: frames per second analysed + cap per video
# (each sampled frame = 1 API vision call).
API_VISION_FPS=1
API_VISION_MAX_FRAMES=30

# Provider health cooldowns (seconds, min 30): a provider that rejects the key
# (401/403) or exhausts quota (429) is skipped until the cooldown expires,
# so live analysis degrades gracefully instead of retrying every frame.
VISION_AUTH_COOLDOWN_S=300
VISION_QUOTA_COOLDOWN_S=120

# Optional: per-attempt HTTP timeout in seconds (default 25).
LLM_TIMEOUT_S=25

# Text task provider order (§8: Gemini-powered explanations, Groq fallback).
# Comma-separated subset of: gemini, groq. Default: gemini,groq
LLM_TEXT_ORDER=gemini,groq

# Structured explanation efficiency (§8.3): cooldown in seconds between fresh
# generations for the same tank+video scope; unchanged evidence reuses cache.
EXPLAIN_COOLDOWN_S=60

# Track II D1: dissolved-oxygen physics estimate (advisory only, no sensor).
# AQUA_DO_PREDICT=0 disables GET /api/do-prediction and the R7 rule (one-line rollback).
AQUA_DO_PREDICT=1
# Kit calibration stays DORMANT until a DO test kit exists.
AQUA_DO_CAL=0
# AQUA_DO_ALERT=0 disables the estimated-DO alert/SMS only.
AQUA_DO_ALERT=1
AQUA_DO_WARN_MGL=3.5
AQUA_DO_CRIT_MGL=2.0
AQUA_ALTITUDE_M=310
# Farm-local clock for diurnal phase, feeding windows and daily digest.
AQUA_FARM_TZ=Asia/Kolkata
# Post-feeding dip correction (F1): -0.08 only during +2..+4 h after the latest feed.
AQUA_DO_FEED_DIP=1

# Track III BEH-A/BEH-B: camera-track behaviour score, sustained hypoxia SMS,
# and one-band DO escalation. All are one-line rollbacks; SIDE view is primary.
AQUA_BEH_ALERT=1
AQUA_BEH_HBS_SUSPECT=60
AQUA_BEH_WARMUP_DAYS=3
AQUA_BEH_SMS_REPEAT_MIN=60
AQUA_BEH_DO_LINK=1

# Track IV F1: farmer feeding tap, appetite grading, and R9 weak-response SMS.
AQUA_FEED_LOG=1
AQUA_FEED_ALERT=1

# Track IV F3: one English digest per farm day at farm-local AQUA_DAILY_SMS_TIME.
AQUA_DIGEST=1
AQUA_DAILY_SMS_TIME=07:00

# Track IV F4: daily top-level data backup (7-day retention) and zip export.
AQUA_BACKUP=1
AQUA_BACKUP_RETENTION_DAYS=7
AQUA_EXPORT=1
# AQUA_BACKUP_DIR=backend/data/backups
